# RaidKey Environment Configuration
# Notice: RaidKey supports both live on-chain ERC-4337 testnet execution and high-fidelity simulated execution mode.

# RPC Endpoints (Optional for live on-chain operations)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.ankr.com/eth_sepolia
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ERC-4337 Bundler & Paymaster (e.g. Pimlico / Biconomy / ZeroDev)
NEXT_PUBLIC_BUNDLER_RPC_URL=https://api.pimlico.io/v2/sepolia/rpc?apikey=demo_key
NEXT_PUBLIC_PAYMASTER_RPC_URL=https://api.pimlico.io/v2/sepolia/rpc?apikey=demo_key

# Smart Contract Addresses (Pre-deployed demo contracts on Sepolia)
NEXT_PUBLIC_RAID_DUNGEON_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
NEXT_PUBLIC_SESSION_VALIDATOR_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
